# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Everything here must also be set in the Vercel project (Settings →
# Environment Variables) — the deploy builds from a clean checkout and cannot
# see .env.local, and a missing key there is a page that prerenders to an
# error rather than a build that fails loudly.

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — it is what lets /api/checkout
# price an order from the catalogue instead of trusting the browser, and what
# lets the gateway callbacks mark an order paid without a signed-in user.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- SSLCommerz ------------------------------------------------------------
# From the merchant panel. Sandbox and live are different stores with
# different credentials — swapping environments means swapping all three.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# "true" uses securepay.sslcommerz.com and takes real money.
# Anything else (including unset) uses the sandbox.
SSLCOMMERZ_IS_LIVE=false

# --- Site ------------------------------------------------------------------
# The public origin, no trailing slash. SSLCommerz is told to send the
# customer back here and to call the IPN here, so on a deployed site this must
# be the real domain — a stale value silently sends paying customers to the
# wrong host. Locally, http://localhost:3000 works for the redirect legs; the
# IPN cannot reach localhost at all (see SSLCOMMERZ-SETUP.md).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
